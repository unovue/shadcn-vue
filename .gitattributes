# Store and check out text files with LF; git still auto-detects binaries
* text=auto eol=lf

# Explicit binary types, as a fallback to auto-detection
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.mp4 binary
*.webm binary
*.pdf binary
*.lockb binary
