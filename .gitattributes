# Force LF for all text files, normalizing CRLF ones on their next commit
* text eol=lf

# `text` disables binary detection, so list every binary type here
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.mp4 binary
*.webm binary
*.pdf binary
*.lockb binary
