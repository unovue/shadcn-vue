# Normalize text files to LF in the repo and in every checkout,
# regardless of each contributor's core.autocrlf setting.
* text=auto eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.mp4 binary
*.webm binary
*.pdf binary
*.lockb binary
