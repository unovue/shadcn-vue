# Normalize text files to LF in the repo and in every checkout,
# regardless of each contributor's core.autocrlf setting.
# `text` (not `text=auto`) also normalizes files already stored with CRLF
# the next time they are committed.
* text eol=lf

# Binary assets: every binary file type must be listed here, since `text`
# disables git's binary detection.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.mp4 binary
*.webm binary
*.pdf binary
*.lockb binary
