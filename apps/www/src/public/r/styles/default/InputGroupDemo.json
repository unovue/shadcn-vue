{
  "name": "InputGroupDemo",
  "type": "registry:example",
  "dependencies": [],
  "registryDependencies": [
    "dropdown-menu",
    "input-group",
    "separator",
    "tooltip"
  ],
  "files": [
    {
      "path": "examples/InputGroupDemo.vue",
      "content": "<script setup lang=\"ts\">\r\nimport { ArrowUpIcon, CheckIcon, InfoIcon, PlusIcon, Search } from \"lucide-vue-next\"\r\nimport { DropdownMenu, DropdownMenuContent, DropdownMenuItem, DropdownMenuTrigger } from \"@/registry/default/ui/dropdown-menu\"\r\nimport { InputGroup, InputGroupAddon, InputGroupButton, InputGroupInput, InputGroupText, InputGroupTextarea } from \"@/registry/default/ui/input-group\"\r\nimport { Separator } from \"@/registry/default/ui/separator\"\r\nimport { Tooltip, TooltipContent, TooltipTrigger } from \"@/registry/default/ui/tooltip\"\r\n</script>\r\n\r\n<template>\r\n  <div class=\"grid w-full max-w-sm gap-6\">\r\n    <InputGroup>\r\n      <InputGroupInput placeholder=\"Search...\" />\r\n      <InputGroupAddon>\r\n        <Search />\r\n      </InputGroupAddon>\r\n      <InputGroupAddon align=\"inline-end\">\r\n        12 results\r\n      </InputGroupAddon>\r\n    </InputGroup>\r\n    <InputGroup>\r\n      <InputGroupInput placeholder=\"example.com\" class=\"!pl-1\" />\r\n      <InputGroupAddon>\r\n        <InputGroupText>https://</InputGroupText>\r\n      </InputGroupAddon>\r\n      <InputGroupAddon align=\"inline-end\">\r\n        <Tooltip>\r\n          <TooltipTrigger as-child>\r\n            <InputGroupButton class=\"rounded-full\" size=\"icon-xs\">\r\n              <InfoIcon class=\"size-4\" />\r\n            </InputGroupButton>\r\n          </TooltipTrigger>\r\n          <TooltipContent>This is content in a tooltip.</TooltipContent>\r\n        </Tooltip>\r\n      </InputGroupAddon>\r\n    </InputGroup>\r\n    <InputGroup>\r\n      <InputGroupTextarea placeholder=\"Ask, Search or Chat...\" />\r\n      <InputGroupAddon align=\"block-end\">\r\n        <InputGroupButton\r\n          variant=\"outline\"\r\n          class=\"rounded-full\"\r\n          size=\"icon-xs\"\r\n        >\r\n          <PlusIcon class=\"size-4\" />\r\n        </InputGroupButton>\r\n        <DropdownMenu>\r\n          <DropdownMenuTrigger as-child>\r\n            <InputGroupButton variant=\"ghost\">\r\n              Auto\r\n            </InputGroupButton>\r\n          </DropdownMenuTrigger>\r\n          <DropdownMenuContent\r\n            side=\"top\"\r\n            align=\"start\"\r\n            class=\"[--radius:0.95rem]\"\r\n          >\r\n            <DropdownMenuItem>Auto</DropdownMenuItem>\r\n            <DropdownMenuItem>Agent</DropdownMenuItem>\r\n            <DropdownMenuItem>Manual</DropdownMenuItem>\r\n          </DropdownMenuContent>\r\n        </DropdownMenu>\r\n        <InputGroupText class=\"ml-auto\">\r\n          52% used\r\n        </InputGroupText>\r\n        <Separator orientation=\"vertical\" class=\"!h-4\" />\r\n        <InputGroupButton\r\n          variant=\"default\"\r\n          class=\"rounded-full\"\r\n          size=\"icon-xs\"\r\n          disabled\r\n        >\r\n          <ArrowUpIcon class=\"size-4\" />\r\n          <span class=\"sr-only\">Send</span>\r\n        </InputGroupButton>\r\n      </InputGroupAddon>\r\n    </InputGroup>\r\n    <InputGroup>\r\n      <InputGroupInput placeholder=\"@shadcn\" />\r\n      <InputGroupAddon align=\"inline-end\">\r\n        <div class=\"flex items-center justify-center rounded-full bg-primary text-primary-foreground size-4\">\r\n          <CheckIcon class=\"size-3\" />\r\n        </div>\r\n      </InputGroupAddon>\r\n    </InputGroup>\r\n  </div>\r\n</template>\r\n",
      "type": "registry:example",
      "target": ""
    }
  ]
}
