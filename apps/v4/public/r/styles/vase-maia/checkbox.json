    {
      "path": "styles/vase-maia/ui/checkbox/Checkbox.vue",
      "content": "<script setup lang=\"ts\">\nimport type { CheckboxEmits, CheckboxProps } from '@vase-ui/vue/checkbox'\n\nimport type { HTMLAttributes } from 'vue'\nimport { CheckIcon, MinusIcon } from '@lucide/vue'\nimport { Checkbox } from '@vase-ui/vue/checkbox'\nimport { cn } from 'cn'\n\ninterface Props extends /* @vue-ignore */ CheckboxProps {\n  class?: HTMLAttributes['class']\n}\ninterface Emits extends /* @vue-ignore */ CheckboxEmits {}\n\nconst props = defineProps<Props>()\ndefineEmits<Emits>()\n</script>\n\n<template>\n  <Checkbox>\n    <template #element=\"{ props: inputProps, elementRef, state }\">\n      <span\n        data-slot=\"checkbox\"\n        :class=\"cn('peer relative inline-flex shrink-0 has-data-checked:text-primary-foreground', props.class)\"\n      >\n        <input\n          v-bind=\"inputProps\"\n          :ref=\"elementRef\"\n          data-slot=\"checkbox-input\"\n          :data-checked=\"state.checked || state.indeterminate ? '' : undefined\"\n          :data-unchecked=\"state.checked || state.indeterminate ? undefined : ''\"\n          class=\"border-input dark:bg-input/30 data-checked:bg-primary data-checked:text-primary-foreground dark:data-checked:bg-primary data-checked:border-primary aria-invalid:aria-checked:border-primary aria-invalid:border-destructive dark:aria-invalid:border-destructive/50 focus-visible:border-ring focus-visible:ring-ring/50 aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 flex size-4 items-center justify-center rounded-[6px] border transition-shadow group-has-disabled/field:opacity-50 focus-visible:ring-3 aria-invalid:ring-3 relative shrink-0 appearance-none outline-none after:absolute after:-inset-x-3 after:-inset-y-2 disabled:cursor-not-allowed disabled:opacity-50 aria-invalid:data-checked:border-primary\"\n        >\n        <span\n          v-if=\"state.checked || state.indeterminate\"\n          data-slot=\"checkbox-indicator\"\n          class=\"[&>svg]:size-3.5 pointer-events-none absolute inset-0 grid place-content-center text-current transition-none\"\n        >\n          <slot :state=\"state\">\n            <MinusIcon v-if=\"state.indeterminate && !state.checked\" />\n            <CheckIcon v-else />\n          </slot>\n        </span>\n      </span>\n    </template>\n  </Checkbox>\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "styles/vase-maia/ui/checkbox/index.ts",
      "content": "export { default as Checkbox } from './Checkbox.vue'\n",
