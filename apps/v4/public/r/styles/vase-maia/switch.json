      "content": "<script setup lang=\"ts\">\nimport type { SwitchEmits, SwitchProps } from '@vase-ui/vue/switch'\nimport type { HTMLAttributes } from 'vue'\nimport { Switch } from '@vase-ui/vue/switch'\nimport { cn } from 'cn'\n\ninterface Props extends /* @vue-ignore */ SwitchProps {\n  class?: HTMLAttributes['class']\n  size?: 'sm' | 'default'\n}\ninterface Emits extends /* @vue-ignore */ SwitchEmits {}\n\nconst props = withDefaults(defineProps<Props>(), {\n  size: 'default',\n})\ndefineEmits<Emits>()\n</script>\n\n<template>\n  <Switch>\n    <template #element=\"{ props: inputProps, elementRef, state }\">\n      <span\n        data-slot=\"switch\"\n        :data-size=\"size\"\n        :class=\"cn('peer group/switch relative inline-flex shrink-0 items-center', props.class)\"\n      >\n        <input\n          v-bind=\"inputProps\"\n          :ref=\"elementRef\"\n          data-slot=\"switch-input\"\n          :data-size=\"size\"\n          :data-checked=\"state.checked ? '' : undefined\"\n          :data-unchecked=\"state.checked ? undefined : ''\"\n          class=\"data-checked:bg-primary data-unchecked:bg-input focus-visible:border-ring focus-visible:ring-ring/50 aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive dark:aria-invalid:border-destructive/50 dark:data-unchecked:bg-input/80 shrink-0 rounded-full border border-transparent focus-visible:ring-3 aria-invalid:ring-3 data-[size=default]:h-[18.4px] data-[size=default]:w-8 data-[size=sm]:h-3.5 data-[size=sm]:w-6 relative appearance-none transition-all outline-none after:absolute after:-inset-x-3 after:-inset-y-2 disabled:cursor-not-allowed disabled:opacity-50\"\n        >\n        <!-- Hidden copy of the track: the thumb sits in the same border box as the input in every style. -->\n        <span\n          aria-hidden=\"true\"\n          class=\"data-checked:bg-primary data-unchecked:bg-input focus-visible:border-ring focus-visible:ring-ring/50 aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive dark:aria-invalid:border-destructive/50 dark:data-unchecked:bg-input/80 shrink-0 rounded-full border border-transparent focus-visible:ring-3 aria-invalid:ring-3 data-[size=default]:h-[18.4px] data-[size=default]:w-8 data-[size=sm]:h-3.5 data-[size=sm]:w-6 pointer-events-none invisible absolute inset-0 flex items-center\"\n        >\n          <span\n            data-slot=\"switch-thumb\"\n            :data-checked=\"state.checked ? '' : undefined\"\n            :data-unchecked=\"state.checked ? undefined : ''\"\n            class=\"bg-background dark:data-unchecked:bg-foreground dark:data-checked:bg-primary-foreground rounded-full group-data-[size=default]/switch:size-4 group-data-[size=sm]/switch:size-3 group-data-[size=default]/switch:data-checked:translate-x-[calc(100%-2px)] group-data-[size=sm]/switch:data-checked:translate-x-[calc(100%-2px)] group-data-[size=default]/switch:data-unchecked:translate-x-0 group-data-[size=sm]/switch:data-unchecked:translate-x-0 visible block ring-0 transition-transform\"\n          >\n            <slot name=\"thumb\" :state=\"state\" />\n          </span>\n        </span>\n      </span>\n    </template>\n  </Switch>\n</template>\n",
