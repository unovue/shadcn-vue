  "files": [
    {
      "path": "styles/vase-luma/ui/command/Command.vue",
      "content": "<script setup lang=\"ts\">\nimport type { HTMLAttributes } from 'vue'\nimport type { CommandItemEntry } from '.'\nimport { Autocomplete } from '@vase-ui/vue/autocomplete'\nimport { cn } from 'cn'\nimport { computed, nextTick, onMounted, ref, shallowReactive, toRef, useId, watch } from 'vue'\nimport { provideCommandContext } from '.'\n\nconst props = withDefaults(defineProps<{\n  class?: HTMLAttributes['class']\n  modelValue?: any\n  multiple?: boolean\n  disabled?: boolean\n  highlightOnHover?: boolean\n}>(), {\n  modelValue: '',\n  highlightOnHover: true,\n})\n\nconst emits = defineEmits<{\n  'update:modelValue': [value: any]\n  'highlight': [value: unknown]\n}>()\n\nconst rootElement = ref<HTMLElement | null>(null)\nconst localValue = ref<any>(props.modelValue)\nconst model = computed<any>({\n  get: () => localValue.value,\n  set: (value) => {\n    localValue.value = value\n    emits('update:modelValue', value)\n  },\n})\n\nwatch(() => props.modelValue, (value) => {\n  localValue.value = value\n}, { deep: true })\n\nconst search = ref('')\nconst highlightedId = ref<string | null>(null)\nconst listId = useId()\nconst items = shallowReactive(new Map<string, CommandItemEntry>())\nconst { contains } = Autocomplete.useFilter({ sensitivity: 'base' })\n\nfunction isVisible(id: string) {\n  const entry = items.get(id)\n\n  // An item that is not in the map yet renders once, to add itself.\n  return !search.value || !entry || contains(entry.text, search.value)\n}\n\nconst visibleCount = computed(() => {\n  if (!search.value) {\n    return items.size\n  }\n\n  return Array.from(items.keys()).filter(isVisible).length\n})\n\nfunction isGroupVisible(groupId: string) {\n  if (!search.value) {\n    return true\n  }\n\n  return Array.from(items).some(([id, entry]) => entry.groupId === groupId && isVisible(id))\n}\n\nfunction isSelected(value: unknown) {\n  return Array.isArray(model.value)\n    ? model.value.some(selected => Object.is(selected, value))\n    : Object.is(model.value, value)\n}\n\nfunction select(value: unknown) {\n  if (props.disabled) {\n    return\n  }\n\n  if (props.multiple) {\n    const selected: unknown[] = Array.isArray(model.value) ? model.value : []\n\n    model.value = isSelected(value) ? selected.filter(item => !Object.is(item, value)) : [...selected, value]\n  }\n  else {\n    model.value = value\n  }\n}\n\nfunction getOptions() {\n  return Array.from(\n    rootElement.value?.querySelectorAll<HTMLElement>('[role=\"option\"]:not([aria-disabled=\"true\"])') ?? [],\n  )\n}\n\nfunction highlight(id: string | null) {\n  if (highlightedId.value === id) {\n    return\n  }\n\n  highlightedId.value = id\n  emits('highlight', id ? items.get(id)?.value : undefined)\n}\n\nfunction moveHighlight(direction: 'next' | 'previous') {\n  const options = getOptions()\n\n  if (!options.length) {\n    return\n  }\n\n  const current = options.findIndex(option => option.id === highlightedId.value)\n  const next = direction === 'next'\n    ? Math.min(current + 1, options.length - 1)\n    : Math.max(current === -1 ? options.length - 1 : current - 1, 0)\n\n  highlight(options[next]!.id)\n  options[next]!.scrollIntoView?.({ block: 'nearest' })\n}\n\nfunction selectHighlighted(originalEvent: Event) {\n  if (highlightedId.value) {\n    items.get(highlightedId.value)?.select(originalEvent)\n  }\n}\n\nfunction highlightFirst() {\n  highlight(getOptions()[0]?.id ?? null)\n}\n\nfunction unregisterItem(id: string) {\n  items.delete(id)\n\n  if (highlightedId.value === id) {\n    highlight(null)\n    void nextTick(highlightFirst)\n  }\n}\n\nwatch(search, async () => {\n  await nextTick()\n  highlightFirst()\n})\n\nonMounted(highlightFirst)\n\nprovideCommandContext({\n  search,\n  disabled: computed(() => Boolean(props.disabled)),\n  listId,\n  highlightedId,\n  highlightOnHover: toRef(props, 'highlightOnHover'),\n  items,\n  visibleCount,\n  isVisible,\n  isGroupVisible,\n  isSelected,\n  highlight,\n  moveHighlight,\n  selectHighlighted,\n  select,\n  unregisterItem,\n})\n</script>\n\n<template>\n  <div\n    ref=\"rootElement\"\n    data-slot=\"command\"\n    :class=\"cn('bg-popover text-popover-foreground rounded-4xl p-1 flex size-full flex-col overflow-hidden', props.class)\"\n  >\n    <slot />\n  </div>\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "styles/vase-luma/ui/command/CommandDialog.vue",
      "content": "<script setup lang=\"ts\">\nimport type { DialogRootEmits, DialogRootProps } from '@vase-ui/vue/dialog'\nimport type { HTMLAttributes } from 'vue'\nimport { cn } from 'cn'\nimport { Dialog, DialogContent, DialogDescription, DialogHeader, DialogTitle } from '@/styles/vase-luma/ui/dialog'\nimport Command from './Command.vue'\n\ninterface Props extends /* @vue-ignore */ DialogRootProps {\n  title?: string\n  description?: string\n  class?: HTMLAttributes['class']\n  showCloseButton?: boolean\n}\ninterface Emits extends /* @vue-ignore */ DialogRootEmits {}\n\nconst props = withDefaults(defineProps<Props>(), {\n  title: 'Command Palette',\n  description: 'Search for a command to run...',\n  showCloseButton: false,\n})\ndefineEmits<Emits>()\n</script>\n\n<template>\n  <Dialog v-slot=\"slotProps\">\n    <DialogContent\n      :class=\"cn('rounded-4xl! top-1/3 translate-y-0 overflow-hidden p-0', props.class)\"\n      :show-close-button=\"showCloseButton\"\n    >\n      <DialogHeader class=\"sr-only\">\n        <DialogTitle>{{ title }}</DialogTitle>\n        <DialogDescription>{{ description }}</DialogDescription>\n      </DialogHeader>\n      <Command>\n        <slot v-bind=\"slotProps\" />\n      </Command>\n    </DialogContent>\n  </Dialog>\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "styles/vase-luma/ui/command/CommandEmpty.vue",
      "content": "<script setup lang=\"ts\">\nimport type { Component, HTMLAttributes } from 'vue'\nimport { cn } from 'cn'\nimport { computed } from 'vue'\nimport { useCommand } from '.'\n\nconst props = withDefaults(defineProps<{\n  as?: keyof HTMLElementTagNameMap | Component\n  class?: HTMLAttributes['class']\n}>(), {\n  as: 'div',\n})\n\nconst command = useCommand()\n\nconst isRender = computed(() => !!command.search.value && command.visibleCount.value === 0)\n</script>\n\n<template>\n  <component\n    :is=\"as\"\n    v-if=\"isRender\"\n    data-slot=\"command-empty\"\n    :class=\"cn('py-6 text-center text-sm', props.class)\"\n  >\n    <slot />\n  </component>\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "styles/vase-luma/ui/command/CommandGroup.vue",
      "content": "<script setup lang=\"ts\">\nimport type { HTMLAttributes } from 'vue'\nimport { cn } from 'cn'\nimport { computed, useId } from 'vue'\nimport { provideCommandGroupContext, useCommand } from '.'\n\nconst props = defineProps<{\n  class?: HTMLAttributes['class']\n  heading?: string\n}>()\n\nconst command = useCommand()\nconst id = useId()\nconst headingId = useId()\n\nconst isRender = computed(() => command.isGroupVisible(id))\n\nprovideCommandGroupContext({ id })\n</script>\n\n<template>\n  <div\n    :id=\"id\"\n    data-slot=\"command-group\"\n    role=\"group\"\n    :aria-labelledby=\"heading ? headingId : undefined\"\n    :class=\"cn('text-foreground **:[[cmdk-group-heading]]:text-muted-foreground overflow-hidden p-1.5 **:[[cmdk-group-heading]]:px-3 **:[[cmdk-group-heading]]:py-2 **:[[cmdk-group-heading]]:text-xs **:[[cmdk-group-heading]]:font-medium', props.class)\"\n    :hidden=\"isRender ? undefined : true\"\n  >\n    <div\n      v-if=\"heading\"\n      :id=\"headingId\"\n      data-slot=\"command-group-heading\"\n      cmdk-group-heading=\"\"\n      class=\"\"\n      aria-hidden=\"true\"\n    >\n      {{ heading }}\n    </div>\n    <slot />\n  </div>\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "styles/vase-luma/ui/command/CommandInput.vue",
      "content": "<script setup lang=\"ts\">\nimport type { HTMLAttributes } from 'vue'\n\nimport { SearchIcon } from '@lucide/vue'\nimport { cn } from 'cn'\nimport { onMounted, ref } from 'vue'\nimport { InputGroup, InputGroupAddon } from '@/styles/vase-luma/ui/input-group'\nimport { useCommand } from '.'\n\ndefineOptions({\n  inheritAttrs: false,\n})\n\nconst props = defineProps<{\n  class?: HTMLAttributes['class']\n}>()\n\nconst command = useCommand()\n\nconst inputElement = ref<HTMLInputElement | null>(null)\n\nfunction handleKeydown(event: KeyboardEvent) {\n  if (event.isComposing || command.disabled.value) {\n    return\n  }\n\n  if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {\n    event.preventDefault()\n    command.moveHighlight(event.key === 'ArrowDown' ? 'next' : 'previous')\n  }\n  else if (event.key === 'Enter') {\n    event.preventDefault()\n    command.selectHighlighted(event)\n  }\n}\n\nonMounted(() => inputElement.value?.focus())\n</script>\n\n<template>\n  <div\n    data-slot=\"command-input-wrapper\"\n    class=\"p-1 pb-0\"\n  >\n    <InputGroup class=\"bg-input/50 h-9\">\n      <input\n        v-bind=\"$attrs\"\n        ref=\"inputElement\"\n        v-model=\"command.search.value\"\n        data-slot=\"command-input\"\n        type=\"text\"\n        role=\"combobox\"\n        aria-expanded=\"true\"\n        aria-autocomplete=\"list\"\n        autocomplete=\"off\"\n        autocorrect=\"off\"\n        :spellcheck=\"false\"\n        :aria-controls=\"command.listId\"\n        :aria-activedescendant=\"command.highlightedId.value ?? undefined\"\n        :disabled=\"command.disabled.value || undefined\"\n        :class=\"cn('w-full text-sm outline-hidden disabled:cursor-not-allowed disabled:opacity-50', props.class)\"\n        @keydown=\"handleKeydown\"\n      >\n      <InputGroupAddon>\n        <SearchIcon class=\"size-4 shrink-0 opacity-50\" />\n      </InputGroupAddon>\n    </InputGroup>\n  </div>\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "styles/vase-luma/ui/command/CommandItem.vue",
      "content": "<script setup lang=\"ts\">\nimport type { HTMLAttributes } from 'vue'\n\nimport type { CommandSelectEvent } from '.'\nimport { CheckIcon } from '@lucide/vue'\nimport { cn } from 'cn'\nimport { computed, onBeforeUnmount, onMounted, ref, useId } from 'vue'\nimport { useCommand, useCommandGroup } from '.'\n\nconst props = defineProps<{\n  class?: HTMLAttributes['class']\n  value?: any\n  disabled?: boolean\n}>()\n\nconst emits = defineEmits<{\n  select: [event: CommandSelectEvent]\n}>()\n\nconst id = useId()\nconst command = useCommand()\nconst group = useCommandGroup()\n\nconst itemElement = ref<HTMLElement | null>(null)\n\nconst isDisabled = computed(() => Boolean(props.disabled || command.disabled.value))\nconst isRender = computed(() => command.isVisible(id))\nconst isHighlighted = computed(() => command.highlightedId.value === id)\n\nfunction handleSelect(originalEvent: Event) {\n  if (isDisabled.value) {\n    return\n  }\n\n  const event: CommandSelectEvent = new CustomEvent('select', {\n    cancelable: true,\n    detail: { originalEvent, value: props.value },\n  })\n\n  emits('select', event)\n\n  if (!event.defaultPrevented) {\n    command.select(props.value)\n    command.search.value = ''\n  }\n}\n\nonMounted(() => {\n  command.items.set(id, {\n    // The search matches the text that the item shows, else its value.\n    text: itemElement.value?.textContent?.trim() || String(props.value ?? ''),\n    value: props.value,\n    groupId: group?.id,\n    select: handleSelect,\n  })\n})\n\nonBeforeUnmount(() => {\n  command.unregisterItem(id)\n})\n</script>\n\n<template>\n  <div\n    v-if=\"isRender\"\n    :id=\"id\"\n    ref=\"itemElement\"\n    data-slot=\"command-item\"\n    role=\"option\"\n    :aria-selected=\"isHighlighted\"\n    :aria-disabled=\"isDisabled ? 'true' : undefined\"\n    :data-disabled=\"isDisabled ? 'true' : undefined\"\n    :data-highlighted=\"isHighlighted ? '' : undefined\"\n    :data-checked=\"command.isSelected(value) ? 'true' : undefined\"\n    :class=\"cn('data-highlighted:bg-muted data-highlighted:text-foreground data-highlighted:*:[svg]:text-foreground relative flex cursor-default items-center gap-2 rounded-2xl px-3 py-2 text-sm font-medium outline-hidden select-none in-data-[slot=dialog-content]:rounded-3xl [&_svg:not([class*=size-])]:size-4 group/command-item data-[disabled=true]:pointer-events-none data-[disabled=true]:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0', props.class)\"\n    @click=\"handleSelect\"\n    @pointermove=\"!isDisabled && command.highlightOnHover.value && command.highlight(id)\"\n  >\n    <slot />\n    <CheckIcon class=\"ml-auto opacity-0 group-has-data-[slot=command-shortcut]/command-item:hidden group-data-[checked=true]/command-item:opacity-100\" />\n  </div>\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "styles/vase-luma/ui/command/CommandList.vue",
      "content": "<script setup lang=\"ts\">\nimport type { HTMLAttributes } from 'vue'\nimport { cn } from 'cn'\nimport { useCommand } from '.'\n\nconst props = defineProps<{\n  class?: HTMLAttributes['class']\n}>()\n\nconst command = useCommand()\n</script>\n\n<template>\n  <div\n    :id=\"command.listId\"\n    data-slot=\"command-list\"\n    role=\"listbox\"\n    :class=\"cn('no-scrollbar max-h-72 scroll-py-1 outline-none overflow-x-hidden overflow-y-auto', props.class)\"\n  >\n    <div role=\"presentation\">\n      <slot />\n    </div>\n  </div>\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "styles/vase-luma/ui/command/CommandSeparator.vue",
      "content": "<script setup lang=\"ts\">\nimport type { HTMLAttributes } from 'vue'\nimport { cn } from 'cn'\n\nconst props = defineProps<{\n  class?: HTMLAttributes['class']\n}>()\n</script>\n\n<template>\n  <div\n    data-slot=\"command-separator\"\n    role=\"separator\"\n    :class=\"cn('bg-border/50 my-1.5 h-px', props.class)\"\n  />\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "styles/vase-luma/ui/command/CommandShortcut.vue",
      "content": "<script setup lang=\"ts\">\nimport type { HTMLAttributes } from 'vue'\nimport { cn } from 'cn'\n\nconst props = defineProps<{\n  class?: HTMLAttributes['class']\n}>()\n</script>\n\n<template>\n  <span\n    data-slot=\"command-shortcut\"\n    :class=\"cn('text-muted-foreground group-data-highlighted/command-item:text-foreground ml-auto text-xs tracking-widest', props.class)\"\n  >\n    <slot />\n  </span>\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "styles/vase-luma/ui/command/index.ts",
      "content": "import type { InjectionKey, Ref } from 'vue'\nimport { inject, provide } from 'vue'\n\nexport { default as Command } from './Command.vue'\nexport { default as CommandDialog } from './CommandDialog.vue'\nexport { default as CommandEmpty } from './CommandEmpty.vue'\nexport { default as CommandGroup } from './CommandGroup.vue'\nexport { default as CommandInput } from './CommandInput.vue'\nexport { default as CommandItem } from './CommandItem.vue'\nexport { default as CommandList } from './CommandList.vue'\nexport { default as CommandSeparator } from './CommandSeparator.vue'\nexport { default as CommandShortcut } from './CommandShortcut.vue'\n\nexport type CommandSelectEvent = CustomEvent<{ originalEvent: Event, value: any }>\n\nexport interface CommandItemEntry {\n  text: string\n  value: unknown\n  groupId?: string\n  select: (originalEvent: Event) => void\n}\n\nexport interface CommandContext {\n  search: Ref<string>\n  disabled: Readonly<Ref<boolean>>\n  listId: string\n  highlightedId: Ref<string | null>\n  highlightOnHover: Readonly<Ref<boolean>>\n  /** The items that the command knows, including the ones that the search hides. */\n  items: Map<string, CommandItemEntry>\n  visibleCount: Readonly<Ref<number>>\n  isVisible: (id: string) => boolean\n  isGroupVisible: (groupId: string) => boolean\n  isSelected: (value: unknown) => boolean\n  highlight: (id: string | null) => void\n  moveHighlight: (direction: 'next' | 'previous') => void\n  selectHighlighted: (originalEvent: Event) => void\n  select: (value: unknown) => void\n  unregisterItem: (id: string) => void\n}\n\nconst commandKey: InjectionKey<CommandContext> = Symbol('Command')\nconst groupKey: InjectionKey<{ id: string }> = Symbol('CommandGroup')\n\nexport function provideCommandContext(context: CommandContext) {\n  provide(commandKey, context)\n  return context\n}\n\nexport function useCommand() {\n  const context = inject(commandKey, null)\n\n  if (!context) {\n    throw new Error('`Command` parts must be used inside `Command`.')\n  }\n\n  return context\n}\n\nexport function provideCommandGroupContext(context: { id: string }) {\n  provide(groupKey, context)\n  return context\n}\n\nexport function useCommandGroup() {\n  return inject(groupKey, null)\n}\n",
      "type": "registry:ui"
    }
  ],
  "type": "registry:ui"
}
