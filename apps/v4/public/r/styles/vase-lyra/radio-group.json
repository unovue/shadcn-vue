      "content": "<script setup lang=\"ts\">\nimport type { RadioProps } from '@vase-ui/vue/radio'\nimport type { HTMLAttributes } from 'vue'\nimport { Radio } from '@vase-ui/vue/radio'\nimport { cn } from 'cn'\n\ninterface Props extends /* @vue-ignore */ RadioProps {\n  class?: HTMLAttributes['class']\n  value: RadioProps['value']\n}\n\nconst props = defineProps<Props>()\n</script>\n\n<template>\n  <Radio :value=\"value\">\n    <template #element=\"{ props: inputProps, elementRef, state }\">\n      <span\n        data-slot=\"radio-group-item\"\n        :class=\"cn('peer group/radio-group-item relative inline-flex shrink-0', props.class)\"\n      >\n        <input\n          v-bind=\"inputProps\"\n          :ref=\"elementRef\"\n          data-slot=\"radio-group-input\"\n          :data-checked=\"state.checked ? '' : undefined\"\n          :data-unchecked=\"state.checked ? undefined : ''\"\n          class=\"border-input dark:bg-input/30 data-checked:bg-primary data-checked:text-primary-foreground dark:data-checked:bg-primary data-checked:border-primary aria-invalid:aria-checked:border-primary aria-invalid:border-destructive focus-visible:border-ring focus-visible:ring-ring/50 aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 dark:aria-invalid:border-destructive/50 flex size-4 rounded-full focus-visible:ring-3 aria-invalid:ring-3 relative aspect-square shrink-0 appearance-none border outline-none after:absolute after:-inset-x-3 after:-inset-y-2 disabled:cursor-not-allowed disabled:opacity-50 aria-invalid:data-checked:border-primary\"\n        >\n        <span\n          v-if=\"state.checked\"\n          data-slot=\"radio-group-indicator\"\n          class=\"flex size-4 items-center justify-center pointer-events-none absolute inset-0\"\n        >\n          <slot :state=\"state\">\n            <span class=\"bg-primary-foreground absolute top-1/2 left-1/2 size-2 -translate-x-1/2 -translate-y-1/2 rounded-full\" />\n          </slot>\n        </span>